{
    "name": "mharj-seeds",
    "version": "0.0.1",
    "description": "Service Discovery System",
    "main": "./dist/index.js",
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tsconfig/node24": "^24.0.5",
